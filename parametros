<!DOCTYPE html>
<html lang="es" class="loading-menu">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<title>Parámetros Láser · Tuttovinilos</title>
<link rel="icon" href="data:,">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Montserrat:wght@600;700;800;900&family=Roboto+Mono:wght@400;500;700&display=swap" rel="stylesheet">

<link rel="stylesheet" href="css/menu.css?v=34">

<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#f0f2f9;
  --card:#ffffff;
  --soft:#f8f9ff;
  --soft2:#eef2ff;
  --border:#d9deea;
  --border2:#cfd6e6;
  --text:#182033;
  --muted:#6b7280;
  --brand:#2563eb;
  --brand2:#1d4ed8;
  --danger:#dc2626;
  --warning:#f59e0b;
  --ok:#16a34a;
  --shadow:0 16px 40px rgba(15,23,42,.08);
  --radius:18px;
}
body{
  font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  background:var(--bg);
  color:var(--text);
  min-height:100vh;
}
.page-wrap{
  padding:18px;
  max-width:1500px;
  margin:0 auto;
}
.header-page{
  background:linear-gradient(135deg,#ffffff,#f8f9ff);
  border:1px solid var(--border);
  border-radius:22px;
  padding:18px;
  box-shadow:var(--shadow);
  display:grid;
  grid-template-columns:1fr auto;
  gap:14px;
  align-items:center;
  margin-bottom:16px;
}
.title-box h1{
  font-family:Montserrat,Inter,sans-serif;
  font-size:clamp(22px,3vw,34px);
  font-weight:900;
  letter-spacing:-.04em;
  line-height:1.05;
}
.title-box p{
  color:var(--muted);
  font-size:14px;
  margin-top:6px;
}
.header-actions{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  justify-content:flex-end;
}
.btn{
  border:0;
  cursor:pointer;
  border-radius:13px;
  padding:11px 14px;
  font-weight:800;
  font-size:13px;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:7px;
  background:#e8ecf7;
  color:#1f2937;
  transition:.15s ease;
  min-height:40px;
}
.btn:hover{transform:translateY(-1px);filter:brightness(.98)}
.btn-primary{background:var(--brand);color:#fff}
.btn-danger{background:#fee2e2;color:#991b1b}
.btn-dark{background:#111827;color:#fff}
.btn-soft{background:#eef2ff;color:#1d4ed8}
.btn-small{padding:8px 10px;border-radius:10px;font-size:12px;min-height:34px}
.stats-grid{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:12px;
  margin-bottom:16px;
}
.stat-card{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:18px;
  padding:14px;
  box-shadow:0 10px 28px rgba(15,23,42,.05);
}
.stat-card span{
  display:block;
  color:var(--muted);
  font-size:12px;
  font-weight:800;
  text-transform:uppercase;
  letter-spacing:.05em;
}
.stat-card strong{
  display:block;
  font-size:28px;
  font-weight:900;
  margin-top:4px;
  letter-spacing:-.04em;
}
.panel{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:22px;
  box-shadow:var(--shadow);
  overflow:hidden;
}
.filters{
  padding:14px;
  background:linear-gradient(135deg,#ffffff,#f8f9ff);
  border-bottom:1px solid var(--border);
  display:grid;
  grid-template-columns:2fr 1fr 1fr 1fr 1fr auto;
  gap:10px;
  align-items:end;
}
.field label{
  display:block;
  font-size:11px;
  font-weight:900;
  color:#4b5563;
  text-transform:uppercase;
  letter-spacing:.06em;
  margin-bottom:6px;
}
.input,select,textarea{
  width:100%;
  border:1px solid var(--border2);
  background:#fff;
  color:var(--text);
  border-radius:13px;
  padding:11px 12px;
  font-family:Inter,sans-serif;
  font-size:14px;
  outline:none;
  min-height:42px;
}
.input:focus,select:focus,textarea:focus{
  border-color:var(--brand);
  box-shadow:0 0 0 4px rgba(37,99,235,.11);
}
.table-wrap{overflow:auto;max-height:calc(100vh - 330px)}
table{
  width:100%;
  border-collapse:separate;
  border-spacing:0;
  min-width:1180px;
}
th{
  position:sticky;
  top:0;
  z-index:2;
  background:#f8f9ff;
  color:#374151;
  font-size:11px;
  font-weight:900;
  text-transform:uppercase;
  letter-spacing:.06em;
  padding:12px 10px;
  border-bottom:1px solid var(--border);
  text-align:left;
}
td{
  padding:11px 10px;
  border-bottom:1px solid #eef1f7;
  font-size:13px;
  vertical-align:middle;
}
tr:hover td{background:#fbfcff}
.material-name{font-weight:900;font-size:14px}
.mono{font-family:"Roboto Mono",monospace;font-weight:700}
.badge{
  display:inline-flex;
  align-items:center;
  border-radius:999px;
  padding:5px 8px;
  font-size:11px;
  font-weight:900;
  white-space:nowrap;
}
.badge-corte{background:#dbeafe;color:#1d4ed8}
.badge-grabado{background:#fef3c7;color:#92400e}
.badge-ok{background:#dcfce7;color:#166534}
.badge-test{background:#fef3c7;color:#92400e}
.badge-bad{background:#fee2e2;color:#991b1b}
.badge-laser{background:#eef2ff;color:#3730a3}
.row-actions{display:flex;gap:6px;flex-wrap:wrap}
.empty{
  padding:34px;
  text-align:center;
  color:var(--muted);
  font-weight:700;
}
.modal-backdrop{
  position:fixed;
  inset:0;
  background:rgba(15,23,42,.45);
  display:none;
  align-items:center;
  justify-content:center;
  padding:16px;
  z-index:9999;
}
.modal-backdrop.show{display:flex}
.modal{
  width:min(980px,100%);
  max-height:92vh;
  overflow:auto;
  background:#fff;
  border-radius:24px;
  box-shadow:0 25px 80px rgba(0,0,0,.25);
  border:1px solid var(--border);
}
.modal-head{
  position:sticky;
  top:0;
  background:#fff;
  z-index:3;
  padding:16px;
  border-bottom:1px solid var(--border);
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
}
.modal-head h2{
  font-family:Montserrat,Inter,sans-serif;
  font-size:20px;
  font-weight:900;
  letter-spacing:-.03em;
}
.modal-body{padding:16px}
.form-grid{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:12px;
}
.field-full{grid-column:1/-1}
.modal-foot{
  padding:16px;
  border-top:1px solid var(--border);
  display:flex;
  gap:8px;
  justify-content:flex-end;
  flex-wrap:wrap;
}
.toast{
  position:fixed;
  right:16px;
  bottom:16px;
  background:#111827;
  color:#fff;
  border-radius:14px;
  padding:12px 14px;
  font-weight:800;
  box-shadow:0 16px 50px rgba(0,0,0,.25);
  opacity:0;
  transform:translateY(10px);
  pointer-events:none;
  transition:.2s ease;
  z-index:10000;
}
.toast.show{opacity:1;transform:translateY(0)}
@media(max-width:1050px){
  .stats-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .filters{grid-template-columns:1fr 1fr}
  .filters .field:first-child{grid-column:1/-1}
  .form-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:680px){
  .page-wrap{padding:10px}
  .header-page{grid-template-columns:1fr;padding:14px;border-radius:18px}
  .header-actions{justify-content:stretch}
  .header-actions .btn{flex:1}
  .stats-grid{grid-template-columns:1fr 1fr;gap:8px}
  .stat-card{padding:12px;border-radius:15px}
  .stat-card strong{font-size:22px}
  .filters{grid-template-columns:1fr;padding:10px}
  .form-grid{grid-template-columns:1fr}
  .table-wrap{max-height:none}
}
</style>
</head>

<body>
<div id="menu-container"></div>

<main class="page-wrap">
  <section class="header-page">
    <div class="title-box">
      <h1>Parámetros de Corte Láser</h1>
      <p>Biblioteca técnica informativa para corte y grabado: material, espesor, potencia, velocidad, foco, altura y gas.</p>
    </div>
    <div class="header-actions">
      <button class="btn btn-soft" id="btnExportar">Exportar CSV</button>
      <button class="btn btn-danger" id="btnReset">Restaurar prueba</button>
      <button class="btn btn-primary" id="btnNuevo">+ Nuevo parámetro</button>
    </div>
  </section>

  <section class="stats-grid">
    <div class="stat-card"><span>Total parámetros</span><strong id="statTotal">0</strong></div>
    <div class="stat-card"><span>Materiales</span><strong id="statMateriales">0</strong></div>
    <div class="stat-card"><span>Corte</span><strong id="statCorte">0</strong></div>
    <div class="stat-card"><span>Grabado</span><strong id="statGrabado">0</strong></div>
  </section>

  <section class="panel">
    <div class="filters">
      <div class="field">
        <label>Buscar</label>
        <input class="input" id="buscar" placeholder="Buscar material, nota, espesor...">
      </div>
      <div class="field">
        <label>Material</label>
        <select id="filtroMaterial"></select>
      </div>
      <div class="field">
        <label>Trabajo</label>
        <select id="filtroTrabajo">
          <option value="">Todos</option>
          <option value="Corte">Corte</option>
          <option value="Grabado">Grabado</option>
        </select>
      </div>
      <div class="field">
        <label>Láser</label>
        <select id="filtroLaser">
          <option value="">Todos</option>
          <option value="1">Láser 1</option>
          <option value="2">Láser 2</option>
        </select>
      </div>
      <div class="field">
        <label>Estado</label>
        <select id="filtroEstado">
          <option value="">Todos</option>
          <option value="Recomendado">Recomendado</option>
          <option value="En prueba">En prueba</option>
          <option value="Descartado">Descartado</option>
        </select>
      </div>
      <button class="btn" id="btnLimpiar">Limpiar</button>
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Material</th>
            <th>Espesor</th>
            <th>Trabajo</th>
            <th>Láser</th>
            <th>Pot. Min</th>
            <th>Pot. Max</th>
            <th>Velocidad</th>
            <th>Gas/Aire</th>
            <th>PSI</th>
            <th>Autofocus</th>
            <th>Foco</th>
            <th>Altura</th>
            <th>Estado</th>
            <th>Nota</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody id="tablaBody"></tbody>
      </table>
      <div class="empty" id="emptyBox" style="display:none;">No hay parámetros para mostrar.</div>
    </div>
  </section>
</main>

<div class="modal-backdrop" id="modalBackdrop">
  <div class="modal">
    <div class="modal-head">
      <h2 id="modalTitulo">Nuevo parámetro</h2>
      <button class="btn btn-small" id="btnCerrar">Cerrar</button>
    </div>

    <form id="formParametro">
      <div class="modal-body">
        <input type="hidden" id="paramId">
        <div class="form-grid">
          <div class="field">
            <label>Material</label>
            <input class="input" id="material" list="materialesLista" placeholder="Acrílico" required>
            <datalist id="materialesLista">
              <option value="Acrílico"></option>
              <option value="Rowmark"></option>
              <option value="SS"></option>
              <option value="MDF"></option>
              <option value="PVC"></option>
              <option value="Cartón"></option>
              <option value="Vinil"></option>
              <option value="Papel"></option>
              <option value="Galvanizado"></option>
            </datalist>
          </div>
          <div class="field">
            <label>Espesor</label>
            <input class="input" id="espesor" placeholder="3 mm" required>
          </div>
          <div class="field">
            <label>Tipo de trabajo</label>
            <select id="tipoTrabajo" required>
              <option value="Corte">Corte</option>
              <option value="Grabado">Grabado</option>
            </select>
          </div>
          <div class="field">
            <label>Láser</label>
            <select id="laser" required>
              <option value="1">Láser 1</option>
              <option value="2">Láser 2</option>
            </select>
          </div>

          <div class="field">
            <label>Potencia mínima %</label>
            <input class="input" id="potMin" type="number" step="0.1" placeholder="30" required>
          </div>
          <div class="field">
            <label>Potencia máxima %</label>
            <input class="input" id="potMax" type="number" step="0.1" placeholder="30" required>
          </div>
          <div class="field">
            <label>Velocidad</label>
            <input class="input" id="velocidad" type="number" step="0.1" placeholder="30" required>
          </div>
          <div class="field">
            <label>Unidad velocidad</label>
            <select id="unidadVelocidad">
              <option value="mm/s">mm/s</option>
              <option value="mm/min">mm/min</option>
            </select>
          </div>

          <div class="field">
            <label>Aire / Oxígeno</label>
            <select id="gas">
              <option value="Aire">Aire</option>
              <option value="Oxígeno">Oxígeno</option>
              <option value="Nitrógeno">Nitrógeno</option>
              <option value="Sin aire">Sin aire</option>
            </select>
          </div>
          <div class="field">
            <label>PSI</label>
            <input class="input" id="psi" type="number" step="0.1" placeholder="8">
          </div>
          <div class="field">
            <label>Autofocus</label>
            <select id="autofocus">
              <option value="Sí">Sí</option>
              <option value="No">No</option>
            </select>
          </div>
          <div class="field">
            <label>Foco</label>
            <input class="input" id="foco" type="number" step="0.1" placeholder="1.5">
          </div>

          <div class="field">
            <label>Altura</label>
            <input class="input" id="altura" type="number" step="0.1" placeholder="8">
          </div>
          <div class="field">
            <label>Estado</label>
            <select id="estado">
              <option value="Recomendado">Recomendado</option>
              <option value="En prueba">En prueba</option>
              <option value="Descartado">Descartado</option>
            </select>
          </div>
          <div class="field">
            <label>Resultado</label>
            <select id="resultado">
              <option value="Bueno">Bueno</option>
              <option value="Regular">Regular</option>
              <option value="Quemado">Quemado</option>
              <option value="No cortó">No cortó</option>
              <option value="Mucha rebaba">Mucha rebaba</option>
            </select>
          </div>
          <div class="field">
            <label>Operador</label>
            <input class="input" id="operador" placeholder="Roberto">
          </div>

          <div class="field field-full">
            <label>Nota / observaciones</label>
            <textarea id="nota" rows="3" placeholder="Ejemplo: corte limpio, subir aire, borde quemado, usar boquilla fina..."></textarea>
          </div>
        </div>
      </div>

      <div class="modal-foot">
        <button type="button" class="btn" id="btnCancelar">Cancelar</button>
        <button type="submit" class="btn btn-primary">Guardar parámetro</button>
      </div>
    </form>
  </div>
</div>

<div class="toast" id="toast"></div>

<script src="js/auth.js"></script>
<script src="js/menu.js"></script>
<script src="js/parametros-laser.js?v=1"></script>
</body>
</html>
