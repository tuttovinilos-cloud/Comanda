<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#f5f7fb">
<title>CRM · Tuttovinilos</title>
<style>
:root{
  --bg:#f5f7fb;--panel:#fff;--ink:#162033;--muted:#748096;--line:#e8ecf3;
  --blue:#2947e8;--blue-2:#eef2ff;--nav:#121a2b;--nav-muted:#9aa6bc;
  --green:#17845b;--green-bg:#eaf7f0;--amber:#a76512;--amber-bg:#fff4df;
  --red:#b64343;--red-bg:#fff0ef;--purple:#6f55cb;--shadow:0 7px 24px rgba(24,39,75,.055);
  --radius:16px;--font:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.45 var(--font)}
button,input{font:inherit}
button{cursor:pointer}
.app-shell{min-height:100vh}
.sidebar{position:fixed;inset:0 auto 0 0;width:238px;background:var(--nav);color:#fff;padding:24px 15px 18px;display:flex;flex-direction:column;z-index:5}
.brand{display:flex;align-items:center;gap:11px;padding:0 10px 28px}
.brand-mark{width:37px;height:37px;border-radius:11px;background:linear-gradient(145deg,#6e86ff,#2947e8);display:grid;place-items:center;font-weight:900;font-size:12px;letter-spacing:-.05em;box-shadow:0 5px 16px rgba(41,71,232,.32)}
.brand-name{font-weight:750;font-size:15px;letter-spacing:-.02em}
.brand-sub{font-size:10px;color:#9ca9bf;margin-top:2px;letter-spacing:.08em;text-transform:uppercase}
.nav-label{font-size:10px;color:#73819a;letter-spacing:.11em;text-transform:uppercase;padding:0 11px;margin:12px 0 8px}
.nav{display:grid;gap:4px}
.nav-item{display:flex;align-items:center;gap:12px;padding:11px 12px;border-radius:10px;text-decoration:none;color:var(--nav-muted);font-size:13px;font-weight:560;transition:.15s}
.nav-item:hover{background:#1b263a;color:#fff}
.nav-item.active{background:#263653;color:#fff;box-shadow:inset 3px 0 #8498ff}
.nav-icon{width:18px;height:18px;display:grid;place-items:center;font-size:15px;opacity:.95}
.nav-count{margin-left:auto;background:#35435c;color:#cbd5e1;border-radius:20px;padding:2px 7px;font-size:10px}
.sidebar-bottom{margin-top:auto;border-top:1px solid #293247;padding:16px 9px 0}
.account-user{display:flex;align-items:center;gap:10px}
.avatar{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:#35466a;color:#e5ebff;font-size:11px;font-weight:800}
.user-name{font-size:12px;font-weight:650;color:#f6f8fc}
.user-role{font-size:10px;color:#8e9bb2;margin-top:2px}
.local-chip{margin-top:14px;border:1px solid #344056;color:#acb8ca;border-radius:8px;padding:7px 9px;font-size:10px;display:flex;align-items:center;gap:7px}
.local-dot{width:7px;height:7px;background:#7bd6a8;border-radius:50%}
.main{margin-left:238px;min-height:100vh}
.topbar{height:62px;border-bottom:1px solid var(--line);background:rgba(255,255,255,.78);display:flex;align-items:center;justify-content:space-between;padding:0 34px;position:sticky;top:0;z-index:4;backdrop-filter:blur(10px)}
.breadcrumb{font-size:12px;color:var(--muted)}
.breadcrumb strong{color:#39445a;font-weight:650}
.top-right{display:flex;align-items:center;gap:14px}
.demo-pill{font-size:10px;letter-spacing:.06em;font-weight:750;color:#6a56b5;background:#f0edff;border:1px solid #e4ddff;border-radius:30px;padding:6px 10px;text-transform:uppercase}
.help{border:1px solid var(--line);background:#fff;color:#637087;width:29px;height:29px;border-radius:50%;font-weight:700}
main.content{max-width:1540px;margin:auto;padding:30px 34px 42px}
.page-head{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin-bottom:21px}
.eyebrow{font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:#8290a6;font-weight:750;margin-bottom:6px}
h1{font-size:26px;line-height:1.2;letter-spacing:-.045em;margin:0;font-weight:760}
.subtitle{color:var(--muted);font-size:13px;margin:7px 0 0}
.primary-btn,.secondary-btn{border:0;border-radius:10px;padding:10px 14px;font-weight:680;font-size:12px;display:inline-flex;align-items:center;justify-content:center;gap:8px;white-space:nowrap}
.primary-btn{background:var(--blue);color:white;box-shadow:0 5px 12px rgba(41,71,232,.18)}
.primary-btn:hover{background:#1e3bd3}
.secondary-btn{background:#fff;color:#38445a;border:1px solid var(--line)}
.secondary-btn:hover{border-color:#cdd5e5;background:#fafbfe}
.demo-notice{display:flex;align-items:center;gap:9px;color:#62549a;background:#f3f0ff;border:1px solid #e8e1ff;border-radius:10px;padding:10px 13px;margin-bottom:20px;font-size:11px}
.demo-notice strong{font-weight:750}
.notice-mark{font-size:14px}
.crm-layout{display:grid;grid-template-columns:290px minmax(0,1fr);gap:18px;align-items:start}
.client-panel,.detail-panel,.card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}
.client-panel{overflow:hidden;position:sticky;top:78px}
.client-panel-head{padding:18px 17px 14px;border-bottom:1px solid var(--line)}
.client-panel-title{display:flex;justify-content:space-between;align-items:center}
.client-panel-title h2{font-size:14px;letter-spacing:-.02em;margin:0}
.client-count{font-size:10px;color:#738096;background:#f2f4f8;border-radius:20px;padding:4px 8px}
.search-wrap{position:relative;margin-top:14px}
.search-icon{position:absolute;left:11px;top:8px;color:#8c97a9;font-size:14px}
.search-input{height:35px;width:100%;border-radius:9px;border:1px solid #e3e8f0;padding:0 10px 0 33px;color:var(--ink);outline:none;background:#fbfcfe;font-size:11px}
.search-input:focus{border-color:#aebcff;box-shadow:0 0 0 3px #eef1ff}
.filters{display:flex;gap:5px;margin-top:11px}
.filter-btn{border:0;background:transparent;color:#778398;padding:5px 8px;border-radius:6px;font-size:10px;font-weight:650}
.filter-btn.active{color:#3348c8;background:#eef1ff}
.client-list{padding:7px;max-height:calc(100vh - 265px);overflow:auto}
.client-row{width:100%;border:0;background:transparent;text-align:left;padding:11px 10px;border-radius:10px;display:flex;gap:10px;align-items:flex-start;color:inherit}
.client-row:hover{background:#f7f8fc}
.client-row.selected{background:#f0f3ff;box-shadow:inset 2px 0 #4058eb}
.client-avatar{flex:none;width:34px;height:34px;border-radius:10px;background:#edf0f7;color:#58657c;display:grid;place-items:center;font-size:10px;font-weight:800}
.client-row.selected .client-avatar{background:#dce4ff;color:#3b51d4}
.client-info{min-width:0;flex:1}
.client-name{font-size:11px;font-weight:700;white-space:nowrap;text-overflow:ellipsis;overflow:hidden}
.client-meta{color:#8994a6;font-size:10px;margin-top:3px;white-space:nowrap;text-overflow:ellipsis;overflow:hidden}
.client-side{text-align:right;flex:none}
.client-balance{font-size:10px;font-weight:750;color:#b05a2a;white-space:nowrap}
.client-state{font-size:9px;margin-top:4px;color:#8691a4}
.empty-list{padding:23px 12px;text-align:center;color:#8994a6;font-size:11px}
.detail-panel{padding:20px 21px 22px;min-width:0}
.profile-head{display:flex;justify-content:space-between;gap:18px;align-items:flex-start;padding-bottom:17px;border-bottom:1px solid var(--line)}
.profile-main{display:flex;gap:13px;align-items:center;min-width:0}
.profile-avatar{width:52px;height:52px;border-radius:15px;background:linear-gradient(145deg,#e8edff,#d7e0ff);color:#3b50cc;display:grid;place-items:center;font-weight:800;font-size:14px;flex:none}
.profile-name{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.profile-name h2{font-size:18px;letter-spacing:-.035em;margin:0;font-weight:760}
.status-active{font-size:9px;color:var(--green);background:var(--green-bg);padding:4px 7px;border-radius:20px;font-weight:750}
.profile-sub{font-size:11px;color:#7b879a;margin-top:4px}
.profile-actions{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}
.profile-actions button{padding:8px 10px;font-size:10px}
.profile-meta{display:flex;gap:18px;flex-wrap:wrap;padding:13px 0 15px;color:#6f7b8e;font-size:10px;border-bottom:1px solid var(--line)}
.profile-meta span{display:flex;gap:6px;align-items:center}
.profile-meta b{color:#364158;font-weight:650}
.tabs{display:flex;gap:20px;border-bottom:1px solid var(--line);margin-bottom:17px;overflow:auto}
.tab{border:0;background:none;color:#7b8798;padding:13px 1px 11px;font-size:11px;font-weight:680;white-space:nowrap;position:relative}
.tab.active{color:#3047d2}
.tab.active:after{content:"";position:absolute;bottom:-1px;left:0;right:0;height:2px;border-radius:2px;background:#4058eb}
.section-title{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:2px 0 12px}
.section-title h3{font-size:13px;margin:0;letter-spacing:-.015em}
.section-hint{font-size:10px;color:#8994a6}
.account-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-bottom:18px}
.account-card{border:1px solid var(--line);background:#fff;border-radius:12px;padding:13px 14px;min-width:0}
.account-card.primary{background:#f8f9ff;border-color:#e6eaff}
.account-top{display:flex;justify-content:space-between;align-items:center;color:#68758b;font-size:10px;font-weight:700}
.account-indicator{width:7px;height:7px;border-radius:50%;background:#6175ef}
.account-indicator.gold{background:#db9a34}
.account-value{font-size:21px;font-weight:760;letter-spacing:-.04em;margin-top:9px;white-space:nowrap}
.account-caption{font-size:9px;color:#8994a5;margin-top:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.credit-card .account-value{color:#21815a}
.account-cards .account-value .minor{font-size:12px;letter-spacing:0;color:#7a8799;font-weight:600}
.reconcile-bar{background:#f7faf9;border:1px solid #e2eee8;border-radius:10px;padding:10px 12px;margin-bottom:17px;display:flex;align-items:center;justify-content:space-between;gap:12px}
.reconcile-left{display:flex;align-items:center;gap:9px;min-width:0}
.check-circle{width:22px;height:22px;display:grid;place-items:center;background:#e2f3e9;color:#278257;border-radius:50%;font-weight:800;font-size:11px;flex:none}
.reconcile-copy strong{font-size:10px;display:block}
.reconcile-copy span{font-size:9px;color:#829083}
.reconcile-status{background:#e4f4e9;color:#237951;padding:5px 8px;border-radius:20px;font-size:9px;font-weight:800;letter-spacing:.04em;white-space:nowrap}
.split-grid{display:grid;grid-template-columns:1fr 1.13fr;gap:12px;align-items:start}
.subcard{border:1px solid var(--line);border-radius:12px;overflow:hidden;background:#fff;min-width:0}
.subcard-head{padding:12px 13px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line)}
.subcard-head h3{font-size:11px;margin:0;font-weight:720}
.subcard-head span{font-size:9px;color:#8b96a7}
.payment-list{padding:0 12px}
.payment-item{padding:12px 0;border-bottom:1px solid #f0f2f6}
.payment-item:last-child{border-bottom:0}
.payment-line{display:flex;align-items:flex-start;justify-content:space-between;gap:9px}
.payment-main{min-width:0}
.payment-title{font-size:10px;font-weight:720}
.payment-id{font-size:9px;color:#8792a4;margin-left:5px;font-weight:550}
.payment-reference{font-size:9px;color:#6e7a8e;margin-top:4px}
.payment-amount{text-align:right;white-space:nowrap}
.payment-amount strong{font-size:11px;color:#20815a}
.payment-amount small{display:block;color:#8d98a8;font-size:8px;margin-top:2px}
.payment-breakdown{margin-top:9px;padding:8px 9px;background:#f8f9fc;border-radius:8px}
.break-row{display:flex;justify-content:space-between;gap:10px;font-size:9px;color:#69768b;padding:2px 0}
.break-row strong{color:#374258;font-size:9px;font-weight:680}
.break-row.credit strong{color:#21815a}
.order-list{padding:0 12px}
.order-item{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:9px;padding:12px 0;border-bottom:1px solid #f0f2f6}
.order-item:last-child{border-bottom:0}
.order-id{font-size:9px;color:#78859a;font-weight:650}
.order-name{font-size:10px;font-weight:720;margin-top:3px}
.order-details{font-size:9px;color:#8a95a6;margin-top:4px}
.order-right{text-align:right;white-space:nowrap}
.order-total{font-size:10px;font-weight:720}
.order-balance{font-size:9px;color:#a65c35;margin-top:4px}
.badge{display:inline-flex;padding:3px 6px;border-radius:20px;font-size:8px;font-weight:750;margin-top:5px}
.badge.progress{background:#edf1ff;color:#4558c8}
.badge.done{background:#e8f5ee;color:#30805a}
.badge.review{background:#fff4df;color:#a36c20}
.ledger-card{margin-top:16px;border:1px solid var(--line);border-radius:12px;overflow:hidden}
.ledger-head{padding:12px 14px;background:#fbfcfe;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between}
.ledger-head h3{font-size:11px;margin:0}
.ledger-head button{border:0;background:none;color:#4054d7;font-size:9px;font-weight:700}
.ledger-summary{display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid var(--line)}
.ledger-account{padding:11px 14px}
.ledger-account+ .ledger-account{border-left:1px solid var(--line)}
.ledger-label{font-size:9px;color:#7d899b;font-weight:700}
.ledger-math{font-size:10px;color:#4d5a70;margin-top:5px}
.ledger-math strong{color:#182337}
.ledger-math .minus{color:#bb6334}
.ledger-math .plus{color:#248257}
.ledger-table{width:100%;border-collapse:collapse}
.ledger-table th{text-align:left;background:#fff;color:#8a95a6;font-size:8px;text-transform:uppercase;letter-spacing:.06em;font-weight:750;padding:9px 12px;border-bottom:1px solid #eff1f5}
.ledger-table td{font-size:9px;color:#526077;padding:9px 12px;border-bottom:1px solid #f1f3f6;vertical-align:top}
.ledger-table tr:last-child td{border-bottom:0}
.ledger-table td:first-child{white-space:nowrap;color:#7d899b}
.ledger-table td strong{color:#28354b;font-size:9px}
.money-in{color:#21815a!important;font-weight:700}
.money-out{color:#a65d35!important;font-weight:700}
.account-tag{font-size:8px;color:#8290a3;display:block;margin-top:2px}
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.contact-box{padding:15px;border:1px solid var(--line);border-radius:12px}
.contact-box h3{font-size:11px;margin:0 0 11px}
.contact-person{display:flex;align-items:flex-start;gap:9px;padding:9px 0;border-bottom:1px solid #f0f2f6}
.contact-person:last-child{border-bottom:0}
.contact-initial{width:28px;height:28px;flex:none;border-radius:9px;background:#edf1ff;color:#5669d5;display:grid;place-items:center;font-size:9px;font-weight:800}
.contact-person-info{min-width:0}
.contact-person-info strong{display:block;font-size:10px;color:#344057}
.contact-person-info small{display:block;color:#8490a2;font-size:9px;margin-top:3px;overflow-wrap:anywhere}
.contact-field{margin-top:9px}
.contact-field label{display:block;color:#8994a6;font-size:9px;margin-bottom:3px}
.contact-field span{font-size:10px;color:#354157;font-weight:600}
.note-box{margin-top:12px;padding:13px 14px;border-radius:10px;background:#fafbfe;color:#738096;font-size:10px;line-height:1.6}
.orders-table-wrap{overflow:auto;border:1px solid var(--line);border-radius:11px}
.orders-table{border-collapse:collapse;width:100%;min-width:600px}
.orders-table th{text-align:left;font-size:8px;color:#8893a5;background:#fafbfe;text-transform:uppercase;letter-spacing:.06em;padding:10px;border-bottom:1px solid var(--line)}
.orders-table td{font-size:9px;padding:11px 10px;border-bottom:1px solid #f0f2f6;color:#647188}
.orders-table tr:last-child td{border-bottom:0}
.orders-table td strong{color:#303d53}
.timeline{position:relative;margin:2px 0 0 8px;padding-left:20px;border-left:1px solid #e6eaf2}
.timeline-item{position:relative;padding:0 0 17px 4px}
.timeline-item:last-child{padding-bottom:0}
.timeline-dot{position:absolute;left:-25px;top:2px;width:9px;height:9px;border-radius:50%;background:#7184ed;border:2px solid #fff;box-shadow:0 0 0 1px #dce2ff}
.timeline-dot.payment{background:#48a879;box-shadow:0 0 0 1px #d6efe0}
.timeline-date{font-size:9px;color:#8792a4}
.timeline-title{font-size:10px;font-weight:700;margin-top:2px}
.timeline-detail{font-size:9px;color:#7b8798;margin-top:3px}
.toast{position:fixed;bottom:22px;left:50%;transform:translate(-50%,20px);padding:11px 15px;background:#172238;color:#fff;border-radius:10px;font-size:11px;opacity:0;pointer-events:none;transition:.2s;z-index:20;box-shadow:0 8px 24px #17223833}
.toast.show{opacity:1;transform:translate(-50%,0)}
.footer-note{font-size:9px;color:#9aa4b4;text-align:center;margin-top:18px}
.crm-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:11px;margin:0 0 18px}
.kpi-card{background:#fff;border:1px solid var(--line);border-radius:13px;padding:14px 15px;box-shadow:var(--shadow);min-width:0}
.kpi-head{display:flex;align-items:center;justify-content:space-between;color:#7d899c;font-size:9px;font-weight:700;letter-spacing:.03em}
.kpi-icon{width:25px;height:25px;display:grid;place-items:center;border-radius:8px;background:#eff2ff;color:#5267de;font-size:12px}
.kpi-value{font-size:21px;font-weight:760;letter-spacing:-.04em;margin-top:8px;white-space:nowrap}
.kpi-foot{font-size:9px;color:#8994a5;margin-top:3px}
.kpi-change{color:#23825a;font-weight:700}
.opportunity-strip{display:grid;grid-template-columns:1.35fr 1fr 1fr 1fr .8fr 1fr;gap:9px;padding:12px 13px;margin:13px 0 0;background:#fafbff;border:1px solid #e9ecf7;border-radius:11px}
.opp-field{min-width:0}
.opp-field label{display:block;color:#929caf;font-size:8px;text-transform:uppercase;letter-spacing:.07em;font-weight:750;margin-bottom:4px}
.opp-field strong{display:block;color:#38445a;font-size:9px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.opp-stage{color:#4459d1!important}
.opp-prob{display:flex;align-items:center;gap:6px}
.opp-progress{height:4px;border-radius:9px;background:#e7eaf2;flex:1;min-width:18px;overflow:hidden}
.opp-progress i{height:100%;display:block;background:#6b7ded;border-radius:9px}
.opp-prob small{font-size:8px;color:#69768b}
.quote-status{display:inline-flex;background:#f1efff;color:#6a57be;padding:3px 6px;border-radius:20px;font-size:8px;font-weight:750}
@media(max-width:1200px){.crm-layout{grid-template-columns:260px minmax(0,1fr)}.split-grid{grid-template-columns:1fr}.client-panel{top:75px}.account-cards{grid-template-columns:repeat(3,minmax(0,1fr))}}
