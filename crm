let selectedId=1;
let activeFilter="all";
let activeTab="account";
function esc(value){return String(value==null?"":value).replace(/[&<>"']/g,function(c){return({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]);});}
function number(value){return new Intl.NumberFormat("es-VE",{minimumFractionDigits:2,maximumFractionDigits:2}).format(Number(value)||0);}
function fmt(value,account){return account==="BS"?"Bs "+number(value):"$"+number(value);}
function accountLabel(account){return account==="BS"?"BCV · Bs":"DIVISA · USD";}
function totals(client,account){
  const orders=client.orders.filter(function(o){return o.account===account;});
  const payments=client.payments.filter(function(p){return p.account===account;});
  const charges=orders.reduce(function(s,o){return s+o.total;},0);
  const paid=orders.reduce(function(s,o){return s+o.paid;},0);
  const open=Math.max(charges-paid,0);
  const credit=payments.reduce(function(s,p){return s+p.credit;},0);
  return {charges:charges,paid:paid,open:open,credit:credit,due:Math.max(open-credit,0),favor:Math.max(credit-open,0)};
}
function clientById(id){return clients.find(function(c){return c.id===Number(id);});}
function renderClientList(){
  const q=document.getElementById("clientSearch").value.trim().toLowerCase();
  let rows=clients.filter(function(c){
    const searchable=[c.name,c.contact,c.rif,c.phone,c.email,c.stage,c.origin,c.owner,c.quote].join(" ").toLowerCase();
    const match=searchable.includes(q);
    const due=totals(c,"USD").due+totals(c,"BS").due>0;
    const openOpportunity=Number(c.opportunity||0)>0&&c.stage!=="Ganada"&&c.stage!=="Perdida";
    const filter=activeFilter==="balance"?due:activeFilter==="opportunity"?openOpportunity:activeFilter==="active"?c.active:true;
    return match&&filter;
  });
  document.getElementById("clientCount").textContent=rows.length+" "+(rows.length===1?"registro":"registros");
  document.getElementById("clientList").innerHTML=rows.length?rows.map(function(c){
    const d=totals(c,"USD").due,b=totals(c,"BS").due;
    const balance=d>0&&b>0?"$"+number(d)+" · Bs "+number(b):d>0?"$"+number(d):b>0?"Bs "+number(b):"Sin saldo";
    const state=c.stage+(d+b>0?" · saldo pendiente":"");
    return '<button class="client-row '+(c.id===selectedId?"selected":"")+'" type="button" data-client="'+c.id+'"><span class="client-avatar">'+esc(c.initials)+'</span><span class="client-info"><span class="client-name">'+esc(c.name)+'</span><span class="client-meta">'+esc(c.contact)+' · '+esc(c.type.split(" · ")[0])+'</span></span><span class="client-side"><span class="client-balance">'+balance+'</span><span class="client-state">'+state+'</span></span></button>';
  }).join(""):'<div class="empty-list">No hay coincidencias.</div>';
}
function renderProfile(client){
  const initials=client.initials;
  document.getElementById("profileAvatar").textContent=initials;
  document.getElementById("profileName").textContent=client.name;
  document.getElementById("profileStatus").textContent=client.active?"Activo":"Inactivo";
  document.getElementById("profileSub").textContent=client.type+" · Contacto principal: "+client.contact;
  document.getElementById("profileMeta").innerHTML=
    '<span>▣ <b>RIF/C.I.</b> '+esc(client.rif)+'</span>'+
    '<span>☎ <b>Teléfono</b> '+esc(client.phone)+'</span>'+
    '<span>✉ <b>Correo</b> '+esc(client.email)+'</span>'+
    '<span>⌖ <b>Ubicación</b> '+esc(client.address)+'</span>';
  const opportunity=Number(client.opportunity||0);
  const probability=Math.max(0,Math.min(Number(client.probability||0),100));
  document.getElementById("opportunityStrip").innerHTML=
    '<div class="opp-field"><label>Etapa comercial</label><strong class="opp-stage">'+esc(client.stage)+'</strong></div>'+
    '<div class="opp-field"><label>Origen del contacto</label><strong>'+esc(client.origin)+'</strong></div>'+
    '<div class="opp-field"><label>Responsable</label><strong>'+esc(client.owner)+'</strong></div>'+
    '<div class="opp-field"><label>Oportunidad estimada</label><strong>'+fmt(opportunity,"USD")+'</strong></div>'+
    '<div class="opp-field"><label>Probabilidad</label><div class="opp-prob"><span class="opp-progress"><i style="width:'+probability+'%"></i></span><small>'+probability+'%</small></div></div>'+
    '<div class="opp-field"><label>Próximo seguimiento</label><strong>'+esc(client.next)+' · '+esc(client.quote)+'</strong></div>';
}
function renderAccount(client){
  const usd=totals(client,"USD"),bs=totals(client,"BS");
  const orders=client.orders,payments=client.payments;
  const usdCaption=fmt(usd.open,"USD")+" pendiente en pedidos · "+fmt(usd.credit,"USD")+" a favor";
  const bsCaption=fmt(bs.open,"BS")+" pendiente en pedidos";
  let allocationTotal=payments.reduce(function(sum,p){return sum+p.applied;},0);
  const accountHTML=
    '<div class="section-title"><h3>Resumen de cuenta</h3><span class="section-hint">Saldo neto por moneda · '+orders.length+' pedidos · '+payments.length+' entradas</span></div>'+
    '<div class="account-cards">'+
      '<article class="account-card primary"><div class="account-top"><span>DIVISA · USD</span><i class="account-indicator"></i></div><div class="account-value">'+fmt(usd.due,"USD")+'</div><div class="account-caption">'+esc(usdCaption)+'</div></article>'+
      '<article class="account-card"><div class="account-top"><span>BCV · BOLÍVARES</span><i class="account-indicator gold"></i></div><div class="account-value">'+fmt(bs.due,"BS")+'</div><div class="account-caption">'+esc(bsCaption)+'</div></article>'+
      '<article class="account-card credit-card"><div class="account-top"><span>SALDO A FAVOR</span><span>↗</span></div><div class="account-value">'+fmt(usd.favor,"USD")+' <span class="minor">/ '+fmt(bs.favor,"BS")+'</span></div><div class="account-caption">Crédito sin mezclar entre cuentas</div></article>'+
    '</div>'+
    '<div class="reconcile-bar"><div class="reconcile-left"><span class="check-circle">✓</span><div class="reconcile-copy"><strong>Conciliación de muestra</strong><span>Pedidos emitidos − pagos aplicados − saldo a favor = saldo neto</span></div></div><span class="reconcile-status">CUENTAS SEPARADAS</span></div>'+
    '<div class="split-grid">'+
      '<section class="subcard"><div class="subcard-head"><h3>Entradas de pago</h3><span>'+payments.length+' movimientos</span></div><div class="payment-list">'+renderPayments(client)+'</div></section>'+
      '<section class="subcard"><div class="subcard-head"><h3>Pedidos del cliente</h3><span>'+orders.length+' pedidos</span></div><div class="order-list">'+renderOrderCards(client)+'</div></section>'+
    '</div>'+
    '<section class="ledger-card"><div class="ledger-head"><h3>Conciliación resumida</h3><button type="button" data-tab-link="history">Ver movimientos →</button></div>'+
      '<div class="ledger-summary">'+
        '<div class="ledger-account"><div class="ledger-label">CUENTA DIVISA · USD</div><div class="ledger-math">'+fmt(usd.charges,"USD")+' emitidos − <span class="minus">'+fmt(usd.paid,"USD")+'</span> aplicados − <span class="plus">'+fmt(usd.credit,"USD")+'</span> a favor = <strong>'+fmt(usd.due,"USD")+'</strong> neto</div></div>'+
        '<div class="ledger-account"><div class="ledger-label">CUENTA BCV · BOLÍVARES</div><div class="ledger-math">'+fmt(bs.charges,"BS")+' emitidos − <span class="minus">'+fmt(bs.paid,"BS")+'</span> aplicados = <strong>'+fmt(bs.due,"BS")+'</strong> neto</div></div>'+
      '</div>'+
      '<div class="orders-table-wrap"><table class="ledger-table"><thead><tr><th>Fecha</th><th>Movimiento</th><th>Referencia</th><th>Cargo</th><th>Abono aplicado</th></tr></thead><tbody>'+renderLedgerRows(client)+'</tbody></table></div>'+
    '</section>';
  document.getElementById("tabContent").innerHTML=accountHTML;
  document.querySelectorAll("[data-tab-link]").forEach(function(btn){btn.addEventListener("click",function(){setTab(btn.dataset.tabLink);});});
}
function renderPayments(client){
  if(!client.payments.length)return '<div class="empty-list">Todavía no hay pagos asociados.</div>';
  return client.payments.map(function(p){
    const allocations=p.allocations.map(function(a){return '<div class="break-row"><span>Aplicado al pedido '+esc(a[0])+'</span><strong>'+fmt(a[1],p.account)+'</strong></div>';}).join("");
    const credit=p.credit>0?'<div class="break-row credit"><span>Saldo a favor disponible</span><strong>'+fmt(p.credit,p.account)+'</strong></div>':"";
    return '<article class="payment-item"><div class="payment-line"><div class="payment-main"><div class="payment-title">'+esc(p.method)+'<span class="payment-id">'+esc(p.id)+'</span></div><div class="payment-reference">'+esc(p.date)+' · Ref. '+esc(p.ref)+'</div></div><div class="payment-amount"><strong>+'+fmt(p.received,p.account)+'</strong><small>Recibido · '+(p.account==="BS"?"BCV":"DIVISA")+'</small></div></div><div class="payment-breakdown">'+
      '<div class="break-row"><span>Aplicado a pedidos</span><strong>'+fmt(p.applied,p.account)+'</strong></div>'+credit+allocations+'</div></article>';
  }).join("");
}
function renderOrderCards(client){
  if(!client.orders.length)return '<div class="empty-list">Este cliente todavía no tiene pedidos.</div>';
  return client.orders.map(function(o){
    const due=Math.max(o.total-o.paid,0);
    const badge=o.status==="Pagado"||due===0?"done":o.status==="Solicitud"?"review":"progress";
    return '<article class="order-item"><div><div class="order-id">'+esc(o.id)+' · '+esc(o.date)+' · '+(o.account==="BS"?"BCV":"DIVISA")+'</div><div class="order-name">'+esc(o.name)+'</div><div class="order-details">'+esc(o.details)+'</div></div><div class="order-right"><div class="order-total">'+fmt(o.total,o.account)+'</div><div class="order-balance">'+(due>0?"Pendiente "+fmt(due,o.account):"Saldo cancelado")+'</div><span class="badge '+badge+'">'+esc(o.status)+'</span></div></article>';
  }).join("");
}
function renderLedgerRows(client){
  const rows=[];
  client.orders.forEach(function(o){rows.push({date:o.date,title:"Pedido emitido · "+o.id,ref:o.id,charge:o.total,payment:0,account:o.account,kind:"order"});});
  client.payments.forEach(function(p){rows.push({date:p.date,title:"Pago recibido · "+p.id,ref:p.ref,charge:0,payment:p.applied,account:p.account,kind:"payment"});});
  rows.sort(function(a,b){return b.date.localeCompare(a.date);});
  if(!rows.length)return '<tr><td colspan="5" style="text-align:center;color:#929daf;padding:18px">Sin movimientos de cuenta.</td></tr>';
  return rows.slice(0,6).map(function(r){return '<tr><td>'+esc(r.date)+'</td><td><strong>'+esc(r.title)+'</strong><span class="account-tag">'+(r.account==="BS"?"BCV · bolívares":"DIVISA · USD")+'</span></td><td>'+esc(r.ref)+'</td><td class="money-out">'+(r.charge?fmt(r.charge,r.account):"—")+'</td><td class="money-in">'+(r.payment?fmt(r.payment,r.account):"—")+'</td></tr>';}).join("");
}
function renderOrders(client){
  const rows=client.orders;
  const body=rows.length?rows.map(function(o){const due=Math.max(o.total-o.paid,0);return '<tr><td><strong>'+esc(o.id)+'</strong><div class="account-tag">'+esc(o.date)+'</div></td><td><strong>'+esc(o.name)+'</strong><div class="account-tag">'+esc(o.details)+'</div></td><td>'+esc(o.status)+'</td><td>'+fmt(o.total,o.account)+'</td><td>'+fmt(o.paid,o.account)+'</td><td>'+(due?fmt(due,o.account):"—")+'</td></tr>';}).join(""):'<tr><td colspan="6" style="text-align:center;padding:25px;color:#8994a6">No hay pedidos registrados en esta ficha de ejemplo.</td></tr>';
  document.getElementById("tabContent").innerHTML='<div class="section-title"><h3>Pedidos vinculados al cliente</h3><span class="section-hint">Identificador de pedido · estado de trabajo · cuenta</span></div><div class="orders-table-wrap"><table class="orders-table"><thead><tr><th>Pedido</th><th>Descripción</th><th>Trabajo</th><th>Total</th><th>Abonado</th><th>Saldo</th></tr></thead><tbody>'+body+'</tbody></table></div><div class="note-box">Los pedidos se asocian por el identificador del cliente. Los registros antiguos que no tengan ese vínculo deben revisarse por nombre antes de conciliarlos.</div>';
}
function renderContacts(client){
  const people=(client.contacts||[]).map(function(c,index){return '<div class="contact-person"><span class="contact-initial">'+esc(c.name.split(" ").map(function(n){return n[0]||"";}).slice(0,2).join(""))+'</span><div class="contact-person-info"><strong>'+esc(c.name)+'</strong><small>'+esc(c.role)+(index===0?' · principal':'')+'</small><small>'+esc(c.phone)+' · '+esc(c.email)+'</small></div></div>';}).join("");
  document.getElementById("tabContent").innerHTML='<div class="section-title"><h3>Datos del cliente</h3><span class="section-hint">Ficha principal y contactos vinculados</span></div><div class="contact-grid"><section class="contact-box"><h3>Empresa / persona</h3><div class="contact-field"><label>Razón social</label><span>'+esc(client.name)+'</span></div><div class="contact-field"><label>RIF / cédula</label><span>'+esc(client.rif)+'</span></div><div class="contact-field"><label>Teléfono general</label><span>'+esc(client.phone)+'</span></div><div class="contact-field"><label>Correo general</label><span>'+esc(client.email)+'</span></div><div class="contact-field"><label>Dirección</label><span>'+esc(client.address)+'</span></div></section><section class="contact-box"><h3>Personas de contacto · '+(client.contacts||[]).length+'</h3>'+people+'</section></div><div class="note-box"><strong style="color:#455168">Nota interna</strong><br>'+esc(client.note)+'</div>';
}
function renderQuotes(client){
  const rows=(client.quotes||[]).map(function(q){return '<tr><td><strong>'+esc(q.number)+'</strong><div class="account-tag">'+esc(q.date)+'</div></td><td><strong>'+esc(q.title)+'</strong><div class="account-tag">Vence: '+esc(q.valid)+'</div></td><td><span class="quote-status">'+esc(q.status)+'</span></td><td>'+fmt(q.amount,q.account)+'</td></tr>';}).join("");
  const body=rows||'<tr><td colspan="4" style="text-align:center;padding:25px;color:#8994a6">No hay cotizaciones asociadas en esta ficha.</td></tr>';
  document.getElementById("tabContent").innerHTML='<div class="section-title"><h3>Cotizaciones del cliente</h3><span class="section-hint">Documento · etapa · monto · vigencia</span></div><div class="orders-table-wrap"><table class="orders-table"><thead><tr><th>Número / fecha</th><th>Descripción</th><th>Estado</th><th>Total</th></tr></thead><tbody>'+body+'</tbody></table></div>';
}
function renderHistory(client){
  const items=client.history;
  if(!items.length){document.getElementById("tabContent").innerHTML='<div class="empty-list">Aún no hay actividad para mostrar.</div>';return;}
  document.getElementById("tabContent").innerHTML='<div class="section-title"><h3>Actividad del cliente</h3><span class="section-hint">Pedidos, cambios y pagos en orden cronológico</span></div><div class="timeline">'+items.map(function(item){return '<div class="timeline-item"><span class="timeline-dot '+(item.kind==="payment"?"payment":"")+'"></span><div class="timeline-date">'+esc(item.date)+'</div><div class="timeline-title">'+esc(item.title)+'</div><div class="timeline-detail">'+esc(item.detail)+'</div></div>';}).join("")+'</div>';
}
function setTab(tab){
  activeTab=tab;
  document.querySelectorAll(".tab").forEach(function(btn){const on=btn.dataset.tab===tab;btn.classList.toggle("active",on);btn.setAttribute("aria-selected",on?"true":"false");});
  renderTab();
}
function renderTab(){
  const c=clientById(selectedId);
  if(!c)return;
  document.querySelectorAll(".tab").forEach(function(btn){const on=btn.dataset.tab===activeTab;btn.classList.toggle("active",on);btn.setAttribute("aria-selected",on?"true":"false");});
  if(activeTab==="account")renderAccount(c);
  if(activeTab==="orders")renderOrders(c);
  if(activeTab==="quotes")renderQuotes(c);
  if(activeTab==="contacts")renderContacts(c);
  if(activeTab==="history")renderHistory(c);
}
function renderAll(){
  renderClientList();
  const c=clientById(selectedId);
  if(c){renderProfile(c);renderTab();}
}
function showToast(message){
  const el=document.getElementById("toast");el.textContent=message;el.classList.add("show");
  window.clearTimeout(showToast.timer);showToast.timer=window.setTimeout(function(){el.classList.remove("show");},2600);
}
document.getElementById("clientSearch").addEventListener("input",renderClientList);
document.querySelectorAll(".filter-btn").forEach(function(btn){btn.addEventListener("click",function(){activeFilter=btn.dataset.filter;document.querySelectorAll(".filter-btn").forEach(function(x){x.classList.toggle("active",x===btn);});renderClientList();});});
document.querySelectorAll(".tab").forEach(function(btn){btn.addEventListener("click",function(){setTab(btn.dataset.tab);});});
document.querySelectorAll("[data-toast]").forEach(function(btn){btn.addEventListener("click",function(event){event.preventDefault();showToast(btn.dataset.toast);});});
document.getElementById("clientList").addEventListener("click",function(event){const btn=event.target.closest("[data-client]");if(btn){selectedId=Number(btn.dataset.client);activeTab="account";renderAll();}});
renderAll();
</script>
</body>
</html>

